<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" demote-non-dropping-particle="sort-only" default-locale="nl-NL">
<info>
  <title>Leidraad voor juridische auteurs 2025 (Dutch)</title>
  <title-short>Leidraad 2025</title-short>
  <id>http://www.zotero.org/styles/leidraad-voor-juridische-auteurs-2025</id>
  <link href="http://www.zotero.org/styles/leidraad-voor-juridische-auteurs-2025" rel="self"/>
  <link href="https://www.wolterskluwer.nl/shop/leidraad-voor-juridische-auteurs-2025-9789013178982" rel="documentation"/>
  <author>
    <name>Joël Hendriks</name>
    <email>leidraad.csl@joelhendriks.nl</email>
  </author>
  <category citation-format="note"/>
  <category field="law"/>
  <updated>2025-01-15T12:00:00+01:00</updated>
  <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  
  <!-- 
  LEIDRAAD 2025 EDITIE
  Deze CSL-stijl is  gebaseerd op de Leidraad voor juridische auteurs 2025 (elfde druk), uitgegeven door Wolters Kluwer.
  
  BELANGRIJKSTE WIJZIGINGEN TEN OPZICHTE VAN EERDERE VERSIES:
  - Uitgebreide behandeling van European Case Law Identifier (ECLI) voor jurisprudentie
  - Nieuwe richtlijnen voor verwijzingen naar online bronnen en frequent geactualiseerde uitgaven
  - Bijgewerkte methoden voor persistente identifiers (DOI, Handle, JCDI)
  - Verbeterde weergave van rechtsoverwegingen (r.o.) en paragraafnummers (par.)
  - Nieuwe regels voor verwijzingen naar Caribische regelgeving
  - Uitgebreide hoofdletterrichtlijnen volgens Leidraad 2025
  - Bijgewerkte afkortingenlijst conform de nieuwe editie
  - Nieuwe richtlijnen voor interne verwijzingen en artikelsgewijs commentaar
  
  TECHNISCHE VERBETERINGEN:
  - Betere ondersteuning voor verschillende locator types (p., par., r.o., aant.)
  - Verbeterde sortering van bronnenlijsten volgens Leidraad 2025
  - Bijgewerkte vormgeving van voetnoten
  - Ondersteuning voor nieuwe documenttypen
  
  VERSIE 1.1 (UPDATE)
  verscheen op: 10 maart 2014
  - Geheel in overeenstemming met Leidraad 2013
  - paginanummers kunnen nu ook worden toegevoegd via de daarvoor bedoelde Zotero-interface (als 'locator')
  - Jurisprudentie krijgt standaard de titel mee als die is opgegeven
  - Nu ook wetten, Kamerstukken, Handelingen, etc. conform Leidraad
  - Verschillende taalfoutjes eruit gehaald
  
  VERSIE 1.0
  - Eerste uitgave
  -->
  
  <!-- ALGEMENE OPMERKINGEN
  Alle commentaren hieronder zijn in het Nederlands aangezien dit een Nederlandse verwijzingsstijl is. 
  De commentaren zijn bedoeld voor verdere ontwikkeling van deze stijl.
  -->
  
  <!-- TECHNISCHE OPMERKINGEN
  01. Het veld 'editor' dient gebruikt te worden voor bewerkers.
  02. Het veld 'editorial-director' dient gebruikt te worden voor (eind)redacteuren. 
  03. Het veld 'chapter' dient gebruikt te worden voor verwijzingen binnen boeken.
  04. Het veld 'locator' ondersteunt nu 'paragraph' voor paragraafverwijzingen.
  05. ECLI-nummering wordt automatisch verwerkt in jurisprudentieverwijzingen.
  -->
</info>

  <locale xml:lang="nl-NL">
    <terms>
      <term name="et-al">e.a.</term>
      <term name="editor">
        <single>bewerker</single>
        <multiple>bewerkers</multiple>
      </term>
      <term name="editorial-director">
        <single>redacteur</single>
        <multiple>redacteuren</multiple>
      </term>
      <term name="editorial-director" form="short">red.</term>
      <term name="open-quote">‘</term>
      <term name="close-quote">’</term>
      <term name="accessed">bijgewerkt</term>
      <term name="page">p.</term>
      <term name="paragraph" form="short">par.</term>
      <term name="issue" form="short">afl.</term>
    </terms>
  </locale>

  <!-- Namen -->
  <macro name="creator-long">
    <choose>
      <if variable="editor">
        <names variable="author" suffix="/">
          <name form="long" initialize="true" initialize-with="." and="symbol" delimiter=", " delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="4" et-al-use-first="1">
            <name-part name="family" text-case="capitalize-all"/>
          </name>
        </names>
        <names variable="editor">
          <name form="long" initialize="true" initialize-with="." and="symbol" delimiter=", " delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="4" et-al-use-first="1">
            <name-part name="family" text-case="capitalize-all"/>
          </name>
        </names>
      </if>
      <else-if variable="editorial-director">
        <names variable="editorial-director">
          <name form="long" initialize="true" initialize-with="." and="symbol" delimiter=", " delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="4" et-al-use-first="1">
            <name-part name="family" text-case="capitalize-all"/>
          </name>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
      </else-if>
      <else-if variable="author">
        <names variable="author">
          <name form="long" initialize="true" initialize-with="." and="symbol" delimiter=", " delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="4" et-al-use-first="1">
            <name-part name="family" text-case="capitalize-all"/>
          </name>
        </names>
      </else-if>
    </choose>
  </macro>

  <macro name="creator-short">
    <choose>
      <if variable="editor">
        <names variable="author" suffix="/">
          <name form="short" and="symbol" delimiter=", " delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="4" et-al-use-first="1">
            <name-part name="family" text-case="capitalize-all"/>
          </name>
        </names>
        <names variable="editor">
          <name form="short" and="symbol" delimiter=", " delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="4" et-al-use-first="1">
            <name-part name="family" text-case="capitalize-all"/>
          </name>
        </names>
      </if>
      <else-if variable="editorial-director">
        <names variable="editorial-director">
          <name form="short" and="symbol" delimiter=", " delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="4" et-al-use-first="1">
            <name-part name="family" text-case="capitalize-all"/>
          </name>
        </names>
      </else-if>
      <else-if variable="author">
        <names variable="author">
          <name form="short" and="symbol" delimiter=", " delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="4" et-al-use-first="1">
            <name-part name="family" text-case="capitalize-all"/>
          </name>
        </names>
      </else-if>
    </choose>
  </macro>

  <macro name="container-author">
    <names variable="container-author">
      <name form="long" initialize="true" initialize-with="." and="symbol" delimiter=", " delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="4" et-al-use-first="1">
        <name-part name="family" text-case="capitalize-all"/>
      </name>
    </names>
  </macro>

  <macro name="name-translator">
    <names variable="translator">
      <name form="long" initialize="true" initialize-with="." and="symbol" delimiter=", " delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="4" et-al-use-first="1">
        <name-part name="family" text-case="capitalize-all"/>
      </name>
    </names>
  </macro>

  <!-- Datum -->
  <macro name="year-publication">
    <choose>
      <if variable="original-date">
        <date variable="original-date" prefix="(" suffix=")">
          <date-part name="year"/>
        </date>
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </else>
    </choose>
  </macro>

  <macro name="year-translation">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="year-original">
    <date variable="original-date">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="date-accessed">
    <date variable="accessed">
      <date-part name="day"/>
      <date-part name="month" prefix=" " suffix=" "/>
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="date-legal-case">
    <date variable="issued">
      <date-part name="day" suffix=" "/>
      <date-part name="month" form="long" suffix=" "/>
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="legislation-issued-short">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <!-- Locators -->
  <macro name="locators-pages-only">
    <choose>
      <if variable="page">
        <text value=", p. "/>
        <text variable="page"/>
      </if>
    </choose>
  </macro>

  <!-- Online-indicator -->
  <macro name="online-indicator-bib">
    <choose>
      <if variable="URL accessed" match="any">
        <text value=" (online)"/>
      </if>
    </choose>
  </macro>

  <macro name="online-indicator-footnote">
    <choose>
      <if variable="URL accessed" match="any">
        <group prefix=" (" suffix=")">
          <text term="accessed"/>
          <text value=" "/>
          <text macro="date-accessed"/>
        </group>
      </if>
    </choose>
  </macro>

  <!-- Literatuur: korte verwijzing -->
  <macro name="reference-book-etc-short">
    <choose>
      <if variable="author editor editorial-director" match="any">
        <text macro="creator-short" suffix=" "/>
      </if>
      <else>
        <text variable="title" font-style="italic"/>
      </else>
    </choose>
    <text macro="year-publication"/>
  </macro>

  <!-- Literatuur: lange verwijzing -->
  <macro name="reference-book-etc-long">
    <text macro="creator-long" suffix=" "/>
    <choose>
      <if type="book report" match="any">
        <choose>
          <if variable="translator">
            <text variable="title" font-style="italic" suffix=", "/>
            <text variable="publisher-place"/>
            <text variable="publisher" prefix=": " suffix=" "/>
            <text macro="year-translation"/>
            <group prefix=" (" suffix=")">
              <text variable="original-title" font-style="italic" suffix=" "/>
              <text macro="year-original" suffix=", "/>
              <text macro="name-translator" prefix="vertaald door "/>
            </group>
            <text macro="locators-pages-only"/>
            <text macro="online-indicator-bib"/>
          </if>
          <else>
            <text variable="title" font-style="italic" suffix=", "/>
            <text variable="publisher-place"/>
            <text variable="publisher" prefix=": " suffix=" "/>
            <text macro="year-publication"/>
            <text macro="locators-pages-only"/>
            <text macro="online-indicator-bib"/>
          </else>
        </choose>
      </if>

      <!-- Tijdschriftartikelen -->
      <else-if type="article article-journal" match="any">
        <text variable="title" text-case="sentence" quotes="true" suffix=", "/>
        <text variable="container-title" font-style="italic"/>
        <!-- Jaar en eventueel publicatienummer (issue) als Jaar/Nummer -->
        <text value=" "/>
        <date variable="issued">
          <date-part name="year"/>
        </date>
        <choose>
          <if variable="issue">
            <text value="/"/>
            <text variable="issue"/>
          </if>
        </choose>
        <text macro="locators-pages-only"/>
      </else-if>

      <!-- Krantenartikelen -->
      <else-if type="article-newspaper">
        <text variable="title" text-case="sentence" quotes="true" suffix=", "/>
        <text variable="container-title" font-style="italic" suffix=" "/>
        <date variable="issued">
          <date-part name="day" suffix=" "/>
          <date-part name="month" form="long" suffix=" "/>
          <date-part name="year"/>
        </date>
        <text macro="locators-pages-only"/>
      </else-if>

      <!-- Boekhoofdstukken / bundelbijdragen -->
      <else-if type="chapter paper-conference entry-encyclopedia entry-dictionary" match="any">
        <text variable="title" text-case="sentence" quotes="true" suffix=", in: "/>
        <text macro="container-author" suffix=", "/>
        <text variable="container-title" font-style="italic" suffix=", "/>
        <text variable="publisher-place"/>
        <text variable="publisher" prefix=": " suffix=" "/>
        <text macro="year-publication"/>
        <text macro="locators-pages-only"/>
        <text macro="online-indicator-bib"/>
      </else-if>
    </choose>
  </macro>

  <!-- Wetgeving en parlementaire stukken -->
  <macro name="reference-legislative-short">
    <choose>
      <if type="bill">
        <!-- Kamerstukken, etc. (titel is bv. "Kamerstukken II") -->
        <choose>
          <if variable="title">
            <text variable="title"/>
          </if>
          <else>
            <text variable="container-title"/>
            <text variable="number" prefix=" "/>
          </else>
        </choose>
      </if>
      <else-if type="legislation">
        <!-- Wetten -->
        <choose>
          <if variable="title-short title" match="any">
            <choose>
              <if variable="title">
                <text variable="title"/>
              </if>
              <else>
                <text variable="title-short"/>
              </else>
            </choose>
            <choose>
              <if disambiguate="true">
                <text macro="legislation-issued-short" prefix=" "/>
              </if>
            </choose>
          </if>
          <else>
            <text variable="container-title" suffix=" " font-style="italic"/>
            <text macro="legislation-issued-short"/>
            <text variable="page" prefix=", "/>
          </else>
        </choose>
      </else-if>
    </choose>
  </macro>

  <macro name="reference-legislative-footnote">
    <choose>
      <if type="bill">
        <group suffix=".">
          <text variable="container-title" font-style="italic"/>
          <text variable="volume" prefix=" "/>
          <text variable="number" prefix=", "/>
          <text variable="page" prefix=", "/>
          <choose>
            <if locator="page">
              <text variable="locator" prefix=", p. "/>
            </if>
          </choose>
          <text variable="note" prefix=" (" suffix=")"/>
        </group>
      </if>
      <else-if type="legislation">
        <choose>
          <!-- Verkorte wetsverwijzing: art. + locator + (korte) titel -->
          <if locator="paragraph section">
            <text value="art. "/>
            <text variable="locator" suffix=" "/>
            <text variable="title" form="short"/>
          </if>
          <else>
            <!-- Publicatieblad-verwijzing -->
            <text variable="container-title" suffix=" " font-style="italic"/>
            <text macro="legislation-issued-short" suffix=", "/>
            <text variable="page" suffix="."/>
          </else>
        </choose>
      </else-if>
    </choose>
  </macro>

  <macro name="reference-legislative-long">
    <choose>
      <if type="bill">
        <group suffix=".">
          <text variable="container-title" font-style="italic"/>
          <text variable="volume" prefix=" "/>
          <text variable="number" prefix=", "/>
          <choose>
            <if locator="page">
              <text variable="locator" prefix=", p. "/>
            </if>
          </choose>
          <text variable="note" prefix=" (" suffix=")"/>
        </group>
      </if>
      <else-if type="legislation">
        <group suffix=".">
          <choose>
            <if variable="title-short title" match="any">
              <text variable="container-title" suffix=" " font-style="italic"/>
              <text macro="legislation-issued-short" suffix=", "/>
              <text variable="page"/>
            </if>
            <else>
              <choose>
                <if variable="title">
                  <text variable="title"/>
                </if>
                <else>
                  <text variable="title-short"/>
                </else>
              </choose>
            </else>
          </choose>
        </group>
      </else-if>
    </choose>
  </macro>

  <!-- Jurisprudentie -->
  <macro name="reference-legal-short">
    <text variable="authority" suffix=" "/>
    <text macro="date-legal-case"/>
  </macro>

  <macro name="reference-legal-long">
    <group suffix=".">
      <text variable="authority" suffix=" "/>
      <text macro="date-legal-case"/>
      <!-- ECLI (in "number") -->
      <choose>
        <if variable="number">
          <text value=", ECLI:"/>
          <text variable="number"/>
        </if>
      </choose>
      <!-- r.o. / par. -->
      <choose>
        <if variable="locator">
          <choose>
            <if locator="section">
              <text value=", r.o. "/>
              <text variable="locator"/>
            </if>
            <else-if locator="paragraph">
              <text value=", par. "/>
              <text variable="locator"/>
            </else-if>
          </choose>
        </if>
      </choose>
      <!-- Titel/roepnaam tussen haakjes cursief (indien aanwezig) -->
      <choose>
        <if variable="title">
          <text value=" ("/>
          <text variable="title" font-style="italic"/>
          <text value=")"/>
        </if>
      </choose>
      <!-- Eventuele annotatie/verwijzing in 'note' -->
      <text variable="note" prefix=", " />
    </group>
  </macro>

  <!-- Overigen -->
  <macro name="remains-short">
    <text variable="title" font-style="italic"/>
  </macro>

  <macro name="remains-long">
    <text variable="title" font-style="italic"/>
    <text macro="year-publication" prefix=" "/>
    <text macro="locators-pages-only"/>
  </macro>

  <!-- Voetnoot: verwijzing -->
  <macro name="footnote-reference">
    <choose>
      <!-- Literatuur -->
      <if type="article article-magazine article-newspaper article-journal book chapter paper-conference report review review-book thesis entry-encyclopedia entry-dictionary" match="any">
        <text macro="reference-book-etc-short"/>
        <!-- Specifieke verwijzing p./par. -->
        <choose>
          <if locator="page">
            <text variable="locator" prefix=", p. "/>
          </if>
          <else-if locator="paragraph">
            <text variable="locator" prefix=", par. "/>
          </else-if>
        </choose>
        <!-- Online (bijgewerkt ...) voor encyclopedische/online bijdragen -->
        <choose>
          <if type="entry-encyclopedia entry-dictionary" match="any">
            <text macro="online-indicator-footnote"/>
          </if>
        </choose>
      </if>

      <!-- Wetgeving en parlementaire stukken -->
      <else-if type="bill legislation" match="any">
        <text macro="reference-legislative-footnote"/>
      </else-if>

      <!-- Jurisprudentie -->
      <else-if type="legal_case" match="any">
        <text macro="reference-legal-long"/>
      </else-if>

      <!-- Overig -->
      <else>
        <text macro="remains-long"/>
      </else>
    </choose>
    <text value=" "/>
  </macro>

  <!-- Bibliografie: titel (vet) -->
  <macro name="bibliography-reference-title">
    <choose>
      <!-- Literatuur -->
      <if type="article article-magazine article-newspaper article-journal book chapter paper-conference report review review-book thesis entry-encyclopedia entry-dictionary" match="any">
        <text macro="reference-book-etc-short"/>
      </if>
      <!-- Wetgeving -->
      <else-if type="bill legislation" match="any">
        <text macro="reference-legislative-short"/>
      </else-if>
      <!-- Jurisprudentie -->
      <else-if type="legal_case" match="any">
        <text macro="reference-legal-short"/>
      </else-if>
      <!-- Overigen -->
      <else>
        <text macro="remains-short"/>
      </else>
    </choose>
    <text value=" "/>
  </macro>

  <!-- Bibliografie: lange omschrijving -->
  <macro name="bibliography-reference-long">
    <choose>
      <if type="article article-magazine article-newspaper article-journal book chapter paper-conference report review review-book thesis entry-encyclopedia entry-dictionary" match="any">
        <text macro="reference-book-etc-long"/>
      </if>
      <else-if type="bill legislation" match="any">
        <text macro="reference-legislative-long"/>
      </else-if>
      <else-if type="legal_case" match="any">
        <text macro="reference-legal-long"/>
      </else-if>
      <else>
        <text macro="remains-long"/>
      </else>
    </choose>
  </macro>

  <!-- Sortering binnen secties -->
  <macro name="sort-order-when-same-type">
    <choose>
      <if type="article article-magazine article-newspaper article-journal book chapter paper-conference report review review-book thesis entry-encyclopedia entry-dictionary" match="any">
        <text macro="footnote-reference"/>
        <text macro="year-publication"/>
      </if>
      <else-if type="bill legislation" match="any">
        <choose>
          <if type="legislation">
            <choose>
              <if variable="title">
                <text variable="title"/>
              </if>
              <else>
                <text variable="title-short"/>
              </else>
            </choose>
            <choose>
              <if disambiguate="true">
                <text macro="legislation-issued-short" prefix=" "/>
              </if>
            </choose>
          </if>
          <else-if type="bill">
            <text variable="volume" prefix=" "/>
            <text variable="number" prefix=", "/>
            <text variable="page" prefix=", "/>
          </else-if>
        </choose>
      </else-if>
      <else-if type="legal_case" match="any">
        <text variable="authority" suffix=" "/>
        <text macro="date-legal-case"/>
      </else-if>
      <else>
        <text macro="footnote-reference"/>
        <text macro="year-publication"/>
      </else>
    </choose>
  </macro>

  <!-- Sectievolgorde in bronnenlijst -->
  <macro name="display-order">
    <choose>
      <if type="article article-magazine article-newspaper article-journal book chapter paper-conference report review review-book thesis entry-encyclopedia entry-dictionary" match="any">
        <text value="10"/>
      </if>
      <else-if type="bill legislation" match="any">
        <choose>
          <if type="legislation">
            <text value="21"/>
          </if>
          <else-if type="bill">
            <text value="22"/>
          </else-if>
        </choose>
      </else-if>
      <else-if type="legal_case" match="any">
        <text value="30"/>
      </else-if>
      <else>
        <text value="40"/>
      </else>
    </choose>
  </macro>

  <!-- Citations (voetnoten) -->
  <citation initialize="true" initialize-with="." givenname-disambiguation-rule="by-cite" disambiguate-add-givenname="true" disambiguate-add-year-suffix="true">
    <sort>
      <key macro="footnote-reference"/>
      <key macro="year-publication"/>
    </sort>
    <layout>
      <text macro="footnote-reference"/>
    </layout>
  </citation>

  <!-- Bibliografie -->
  <bibliography>
    <sort>
      <key macro="display-order"/>
      <key macro="sort-order-when-same-type"/>
    </sort>
    <layout>
      <group display="block" font-weight="bold">
        <text macro="bibliography-reference-title"/>
      </group>
      <text macro="bibliography-reference-long"/>
    </layout>
  </bibliography>
</style>
